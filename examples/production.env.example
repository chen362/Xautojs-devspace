# DevSpace production environment example.
# Copy the values into your process manager, container secret store, or shell.
# DevSpace does not auto-load this file.

DEVSPACE_DEPLOYMENT_MODE=production
HOST=0.0.0.0
PORT=7676
DEVSPACE_PUBLIC_BASE_URL=https://devspace.example.com
DEVSPACE_ALLOWED_HOSTS=devspace.example.com
DEVSPACE_ALLOWED_ROOTS=/srv/devspace/workspaces

DEVSPACE_AUTH_MODE=oidc
DEVSPACE_OIDC_ISSUER=https://auth.example.com
DEVSPACE_OIDC_AUDIENCE=https://devspace.example.com/mcp
# Optional when the issuer does not expose /.well-known/jwks.json.
# DEVSPACE_OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# DEVSPACE_OIDC_TENANT_CLAIM=tenant_id
# DEVSPACE_OIDC_USER_CLAIM=sub
DEVSPACE_OIDC_SCOPES=devspace

DEVSPACE_DATABASE_PROVIDER=postgres
DEVSPACE_DATABASE_URL=postgres://devspace:replace-me@db.example.com:5432/devspace
DEVSPACE_POSTGRES_SSL_MODE=require

DEVSPACE_WORKTREE_ROOT=/srv/devspace/worktrees
DEVSPACE_WORKSPACE_SESSION_TTL_SECONDS=2592000
DEVSPACE_WORKSPACE_SESSION_CLEANUP_INTERVAL_SECONDS=3600

DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
